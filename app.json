{
  "expo": {
    "name": "School Fee Cash Manager",
    "slug": "school-fee-cash-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "schoolcash",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.schoolfeecashmanager.app",
      "versionCode": 1
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5aec8748-6f0f-4b9a-900c-933de2b476d5"
      }
    }
  }
}
